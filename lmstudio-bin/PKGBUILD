# Factory: official Linux arm64 AppImage. Namcap rejects ELF under /opt, so
# the image lives in /usr/lib/lmstudio with a --version wrapper.

pkgname=lmstudio-bin
pkgver=0.4.24
pkgrel=1
_pkgver=${pkgver}-1
pkgdesc='LM Studio - a desktop app for exploring and running large language models locally'
arch=('aarch64')
url='https://lmstudio.ai'
license=('LicenseRef-LM-Studio-EULA')
depends=('fuse2' 'zlib' 'hicolor-icon-theme' 'gtk3' 'nss' 'libxcrypt-compat')
provides=('lmstudio')
conflicts=('lmstudio')
options=('!strip')
install=lmstudio-bin.install
source=(
  "LM-Studio-${_pkgver}-arm64.AppImage::https://installers.lmstudio.ai/linux/arm64/${_pkgver}/LM-Studio-${_pkgver}-arm64.AppImage"
  'lmstudio.sh'
  'lmstudio.png'
  'lmstudio.desktop'
  'LICENSE-LM-Studio'
)
sha256sums=(
  'SKIP'
  'c2230027c496b885270b77918acece95377de2f5d74021450faf09bec684d535'
  '9f791789c959a11316328692807737a5f1bc1c170ae99ec04c56bfd8ee8263e5'
  'd5ac11aae025cd1cc0f9aa0713ee427dc6f46e4d1adac2a5948f93d8bbca705f'
  'fda9ef00e0f42a10c08311effc2e1bcfacbd42cc23c15782cbc9fd678056ffb7'
)

package() {
  install -Dm755 "${srcdir}/LM-Studio-${_pkgver}-arm64.AppImage" \
    "${pkgdir}/usr/lib/lmstudio/lm-studio.AppImage"
  install -Dm755 "${srcdir}/lmstudio.sh" "${pkgdir}/usr/bin/lm-studio"
  install -Dm644 "${srcdir}/lmstudio.png" \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/lmstudio-bin.png"
  install -Dm644 "${srcdir}/lmstudio.png" \
    "${pkgdir}/usr/share/pixmaps/lmstudio-bin.png"
  install -Dm644 "${srcdir}/lmstudio.desktop" \
    "${pkgdir}/usr/share/applications/lmstudio.desktop"
  install -Dm644 "${srcdir}/LICENSE-LM-Studio" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-LM-Studio"
}
