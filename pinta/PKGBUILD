# Maintainer: Rafael Baboni Dominiquini <rafaeldominiquini at gmail dot com>

pkgname=pinta
pkgver=3.1.2
pkgrel=3
pkgdesc="Drawing/editing program modeled after Paint.NET. It's goal is to provide a simplified alternative to GIMP for casual users"

arch=('x86_64' 'aarch64')
license=('MIT')
url="https://pinta-project.com"

makedepends=('pkgconf' 'autoconf-archive' 'intltool' 'gtk4' 'libadwaita' 'perl')
# Factory install_deps pacman-installs every depends/makedepends_* name from
# .SRCINFO, including x86_64-only entries. Do not list Arch .NET package
# names here until they exist in an aarch64 pool ring.
_sdkver=10.0.400
depends=('libadwaita' 'hicolor-icon-theme' 'webp-pixbuf-loader')

provides=($pkgname)
conflicts=($pkgname-git)

source=("Pinta-${pkgver}.tar.gz::https://github.com/PintaProject/Pinta/archive/refs/tags/${pkgver}.tar.gz")
source_aarch64=("dotnet-sdk-${_sdkver}-linux-arm64.tar.gz::https://builds.dotnet.microsoft.com/dotnet/Sdk/${_sdkver}/dotnet-sdk-${_sdkver}-linux-arm64.tar.gz")
sha256sums=('98ed517b33f0e40fd1e3915ea5146355845ac12efd3bb07812c68a52c714cac6')
sha512sums_aarch64=('a1b45da58e5591fff909a6126ac6bfc1ef9c12bc72c0625f7815e83a82be1a902317ee96926cbbf81324a45c6abf2ed8102a216d0507879cc166159af78d1b77')
noextract=("dotnet-sdk-${_sdkver}-linux-arm64.tar.gz")

_dotnet_env() {
  export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_NOLOGO=1
  if [[ $CARCH == aarch64 ]]; then
    export DOTNET_ROOT="${srcdir}/dotnet-sdk"
    export PATH="${DOTNET_ROOT}:${PATH}"
  fi
}

_dotnet_rid() {
  case "$CARCH" in
    aarch64) echo linux-arm64 ;;
    *) echo linux-x64 ;;
  esac
}

prepare() {
  if [[ $CARCH == aarch64 ]]; then
    mkdir -p "${srcdir}/dotnet-sdk"
    bsdtar -C "${srcdir}/dotnet-sdk" -xf "${srcdir}/dotnet-sdk-${_sdkver}-linux-arm64.tar.gz"
  fi
  _dotnet_env

  cd "${srcdir}/Pinta-${pkgver}"

  for file in *.md *.txt; do
    basename=$(tr '[:lower:]' '[:upper:]' <<< "${file%.*}")
    newname="$basename.${file#*.}"
    [ ! "$file" == "$newname" ] && mv "$file" "$newname"
  done

  sed -i 's/net8.0/net10.0/g' Directory.Build.props

  ./autogen.sh --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}

build() {
  _dotnet_env
  cd "${srcdir}/Pinta-${pkgver}"

  sed -i -r "s|^(PINTA_BUILD_OPTS\s=\s.*)|\1 -p:RuntimeIdentifier=$(_dotnet_rid)|g" Makefile

  make
}

package() {
  _dotnet_env
  cd "${srcdir}/Pinta-${pkgver}"

  make DESTDIR="${pkgdir}" install

  chmod -v 755 "${pkgdir}/usr/lib/pinta/"*.dll

  if [[ $CARCH == aarch64 ]]; then
    # Framework-dependent Pinta.dll plus a private Microsoft host/runtime so
    # the package does not need pool-ring dotnet-host / dotnet-runtime.
    local _droot="${pkgdir}/usr/lib/pinta-dotnet"
    install -d "${_droot}"
    cp -a "${srcdir}/dotnet-sdk/dotnet" "${_droot}/"
    cp -a "${srcdir}/dotnet-sdk/host" "${_droot}/"
    cp -a "${srcdir}/dotnet-sdk/shared" "${_droot}/"
    cat > "${pkgdir}/usr/bin/pinta" <<'EOF'
#!/bin/bash
export DOTNET_ROOT=/usr/lib/pinta-dotnet
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=0
exec /usr/lib/pinta-dotnet/dotnet /usr/lib/pinta/Pinta.dll "$@"
EOF
    chmod 755 "${pkgdir}/usr/bin/pinta"
  fi

  install -Dm644 -t "${pkgdir}/usr/share/doc/${pkgname}/" *.md
  install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}/" LICENSE*.txt
}
