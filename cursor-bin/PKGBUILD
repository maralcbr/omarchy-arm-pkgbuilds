# Factory: official Linux ARM64 .deb. The AUR cursor-bin recipe is x86_64
# and rebuilds against electron42, which is not in any ARM pool ring.

pkgname=cursor-bin
pkgver=3.20.21
pkgrel=1
pkgdesc='The AI Code Editor (binary release)'
arch=('aarch64')
url='https://www.cursor.com'
license=('LicenseRef-Cursor_EULA')
depends=(
  'alsa-lib'
  'gtk3'
  'libnotify'
  'libxkbfile'
  'libxss'
  'nss'
  'xdg-utils'
)
provides=('cursor')
conflicts=('cursor')
options=('!strip')
_commit=f09fca384ceca23f7bf21f9c23655b162641d747
source=("cursor_${pkgver}_arm64.deb::https://downloads.cursor.com/production/${_commit}/linux/arm64/deb/arm64/deb/cursor_${pkgver}_arm64.deb")
sha256sums=('609707fcd32a443448fcd01fc5046d541e4ff1334d670ac13648d0782f5c47f1')

package() {
  bsdtar -xf data.tar.xz -C "${pkgdir}/"

  install -d "${pkgdir}/usr/bin"
  ln -sf /usr/share/cursor/bin/cursor "${pkgdir}/usr/bin/cursor"

  if [[ -f "${pkgdir}/usr/share/cursor/chrome-sandbox" ]]; then
    chmod 4755 "${pkgdir}/usr/share/cursor/chrome-sandbox"
  fi
}
