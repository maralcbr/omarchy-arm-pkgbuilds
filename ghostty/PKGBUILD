# Maintainer: Caleb Maclennan <caleb@alerque.com>
# Maintainer: Peter Jung <ptr1337@archlinux.org>
#
# Factory note: one package, not the official split. The worker installs
# depends from .SRCINFO with pacman before the build, so split packages that
# depend on each other (ghostty → ghostty-terminfo, nautilus → ghostty)
# fail with "target not found: ghostty". Shell integration is included;
# the Nautilus plugin is omitted. Do not ship /usr/share/terminfo/g/ghostty
# — ncurses already owns that path on Omarchy.

pkgname=ghostty
pkgver=1.3.1
pkgrel=7
pkgdesc='Fast, native, feature-rich terminal emulator pushing modern features'
arch=(aarch64)
url="https://github.com/ghostty-org/ghostty"
license=(MIT)
depends=(
  bzip2
  fontconfig
  freetype2
  glibc
  glib2
  gtk4
  gtk4-layer-shell
  libx11
  harfbuzz
  libadwaita
  libpng
  oniguruma
  pixman
  wayland
  zlib
)
# Gate/project build: upstream tag is v${pkgver} (for example v1.3.1), never
# ${pkgver}-${pkgrel} and never 1.3.1-6.tar.gz.
# Ghostty 1.3.1 requires Zig 0.15.2. Pool extra only has 0.16.0, whose
# package hashes do not match build.zig.zon, so the compiler is the
# official aarch64 tarball rather than the zig package.
_zigver=0.15.2
makedepends=(
  blueprint-compiler
)
_archive="ghostty-$pkgver"
source=(
  "$url/archive/v$pkgver/$_archive.tar.gz"
  "https://ziglang.org/download/${_zigver}/zig-aarch64-linux-${_zigver}.tar.xz"
)
sha256sums=(
  '265837d3026b433f0e6b4e49d43153b915b0a19513f7edd8a8e693c559bd415b'
  '958ed7d1e00d0ea76590d27666efbf7a932281b3d7ba0c6b01b0ff26498f667f'
)

_zig() {
	"$srcdir/zig-aarch64-linux-${_zigver}/zig" "$@"
}

prepare() {
	cd "$_archive"
	PATH="$srcdir/zig-aarch64-linux-${_zigver}:$PATH" \
		ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-global-cache/" \
		./nix/build-support/fetch-zig-cache.sh
}

build() {
	cd "$_archive"
	DESTDIR=build _zig build \
		--summary all \
		--prefix "/usr" \
		--system "$srcdir/zig-global-cache/p" \
		-Doptimize=ReleaseFast \
		-Dgtk-x11=true \
		-Dcpu=baseline \
		-Dpie=true \
		-Demit-docs=false \
		-Dversion-string="$pkgver-arch$pkgrel" \
		--build-id=sha1
}

package() {
	cd "$_archive"
	cp -a build/* "$pkgdir/"
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
	rm -rf "$pkgdir/usr/share/nautilus-python" || true
	# Keep xterm-ghostty; drop the name ncurses already provides.
	rm -f "$pkgdir/usr/share/terminfo/g/ghostty"
	rmdir "$pkgdir/usr/share/terminfo/g" 2>/dev/null || true
}
