# aarch64-only build of the AUR dotnet-core-bin package: Arch Linux ARM ships
# no .NET packages, and the Omarchy default set needs dotnet-runtime for pinta.
#
# Factory note: one package that Provides the Arch split names. The worker
# pacman-installs every .SRCINFO depend before the build, so a split that
# depends on sibling packages (dotnet-runtime → dotnet-host) fails with
# "target not found: dotnet-host".

pkgname=dotnet-core
pkgver=10.0.11.sdk400
_runtimever=10.0.11
_sdkver=10.0.400
_short_ver=10.0
pkgrel=2
pkgdesc='.NET host, runtime and SDK (Microsoft arm64 binaries)'
arch=('aarch64')
url='https://www.microsoft.com/net/core'
license=('MIT')
options=('staticlibs' '!strip')
depends=(
  'libgcc'
  'libstdc++'
  'glibc'
  'icu'
  'libunwind'
  'zlib'
  'openssl'
)
provides=(
  "dotnet-host=${_runtimever}"
  "dotnet-runtime=${_runtimever}"
  "dotnet-runtime-${_short_ver}"
  "aspnet-runtime=${_runtimever}"
  "aspnet-runtime-${_short_ver}"
  "dotnet-sdk=${pkgver}"
  "dotnet-sdk-${_short_ver}=${pkgver}"
  "dotnet-targeting-pack=${_runtimever}"
  "dotnet-targeting-pack-${_short_ver}"
  "aspnet-targeting-pack=${_runtimever}"
  "aspnet-targeting-pack-${_short_ver}"
)
conflicts=(
  'dotnet-host'
  'dotnet-runtime'
  "dotnet-runtime-${_short_ver}"
  'aspnet-runtime'
  "aspnet-runtime-${_short_ver}"
  'dotnet-sdk'
  "dotnet-sdk-${_short_ver}"
  'dotnet-targeting-pack'
  "dotnet-targeting-pack-${_short_ver}"
  'aspnet-targeting-pack'
  "aspnet-targeting-pack-${_short_ver}"
)
source=('dotnet.sh')
source_aarch64=("https://builds.dotnet.microsoft.com/dotnet/Sdk/${_sdkver}/dotnet-sdk-${_sdkver}-linux-arm64.tar.gz")
sha512sums=('768151c7179fb6a126b3de9cae01e363e8894f6fab384b1e2c5066c2adca4578638983b1b62aea10dd18045e6d6e8f8ea13280481134de94f004a118919b2c06')
sha512sums_aarch64=('a1b45da58e5591fff909a6126ac6bfc1ef9c12bc72c0625f7815e83a82be1a902317ee96926cbbf81324a45c6abf2ed8102a216d0507879cc166159af78d1b77')

package() {
  local msarch=arm64

  install -dm 755 "${pkgdir}"/usr/{bin,lib,share/{dotnet,dnx,licenses/dotnet-host,dotnet/shared,dotnet/packs}}
  cp -dr --no-preserve='ownership' dotnet host dnx "${pkgdir}"/usr/share/dotnet/
  cp -dr --no-preserve='ownership' LICENSE.txt ThirdPartyNotices.txt "${pkgdir}"/usr/share/licenses/dotnet-host
  ln -sf /usr/share/dotnet/dotnet "${pkgdir}"/usr/bin/dotnet
  ln -sf /usr/share/dotnet/dnx "${pkgdir}"/usr/bin/dnx
  ln -sf /usr/share/dotnet/host/fxr/"${_runtimever}"/libhostfxr.so "${pkgdir}"/usr/lib/libhostfxr.so
  install -Dm 644 "${srcdir}"/dotnet.sh -t "${pkgdir}"/etc/profile.d/

  cp -dr --no-preserve='ownership' shared/Microsoft.NETCore.App "${pkgdir}"/usr/share/dotnet/shared/
  ln -s dotnet-host "${pkgdir}"/usr/share/licenses/dotnet-runtime

  cp -dr --no-preserve='ownership' shared/Microsoft.AspNetCore.App "${pkgdir}"/usr/share/dotnet/shared/
  ln -s dotnet-host "${pkgdir}"/usr/share/licenses/aspnet-runtime

  cp -dr --no-preserve='ownership' sdk sdk-manifests templates "${pkgdir}"/usr/share/dotnet/
  ln -s dotnet-host "${pkgdir}"/usr/share/licenses/dotnet-sdk

  cp -dr --no-preserve='ownership' packs/Microsoft.NETCore.App.{Host.linux-${msarch},Ref} "${pkgdir}"/usr/share/dotnet/packs/
  ln -s dotnet-host "${pkgdir}"/usr/share/licenses/dotnet-targeting-pack

  cp -dr --no-preserve='ownership' packs/Microsoft.AspNetCore.App.Ref "${pkgdir}"/usr/share/dotnet/packs/
  ln -s dotnet-host "${pkgdir}"/usr/share/licenses/aspnet-targeting-pack
}
