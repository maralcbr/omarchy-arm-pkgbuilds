# aarch64-only build of the AUR dotnet-core-bin package: Arch Linux ARM ships
# no .NET packages, and the Omarchy default set needs dotnet-runtime for pinta.
#
# Factory note: one package that Provides the Arch split names. The worker
# pacman-installs every .SRCINFO depend before the build, so a split that
# depends on sibling packages (dotnet-runtime → dotnet-host) fails with
# "target not found: dotnet-host".
#
# Gate: namcap rejects ELF binaries under usr/share/. Install under
# /usr/lib/dotnet instead and keep the profile.d helper in sync.

pkgname=dotnet-core
pkgver=10.0.11.sdk400
_runtimever=10.0.11
_sdkver=10.0.400
_short_ver=10.0
pkgrel=4
pkgdesc='.NET host, runtime and SDK (Microsoft arm64 binaries)'
arch=('aarch64')
url='https://www.microsoft.com/net/core'
license=('MIT')
options=('staticlibs' '!strip')
depends=(
  'libgcc'
  'libstdc++'
  'glibc'
  'icu'
  'libunwind'
  'zlib'
  'openssl'
)
provides=(
  "dotnet-host=${_runtimever}"
  "dotnet-runtime=${_runtimever}"
  "dotnet-runtime-${_short_ver}"
  "aspnet-runtime=${_runtimever}"
  "aspnet-runtime-${_short_ver}"
  "dotnet-sdk=${pkgver}"
  "dotnet-sdk-${_short_ver}=${pkgver}"
  "dotnet-targeting-pack=${_runtimever}"
  "dotnet-targeting-pack-${_short_ver}"
  "aspnet-targeting-pack=${_runtimever}"
  "aspnet-targeting-pack-${_short_ver}"
)
conflicts=(
  'dotnet-host'
  'dotnet-runtime'
  "dotnet-runtime-${_short_ver}"
  'aspnet-runtime'
  "aspnet-runtime-${_short_ver}"
  'dotnet-sdk'
  "dotnet-sdk-${_short_ver}"
  'dotnet-targeting-pack'
  "dotnet-targeting-pack-${_short_ver}"
  'aspnet-targeting-pack'
  "aspnet-targeting-pack-${_short_ver}"
)
source=('dotnet.sh')
source_aarch64=("https://builds.dotnet.microsoft.com/dotnet/Sdk/${_sdkver}/dotnet-sdk-${_sdkver}-linux-arm64.tar.gz")
sha512sums=('4118a6a008d7bca7c6fc055079cc2c730ad1a0b88fff1834148b7d39c5bb0b6babfa40c148ce44fcc9ec02d4b21d4c2bb17f6e50ec3cec6dee27bc1d2f43060c')
sha512sums_aarch64=('a1b45da58e5591fff909a6126ac6bfc1ef9c12bc72c0625f7815e83a82be1a902317ee96926cbbf81324a45c6abf2ed8102a216d0507879cc166159af78d1b77')
# Upstream ships no automated test target for the repackaged SDK tarball.
# check() intentionally omitted.

package() {
  local msarch=arm64 root="${pkgdir}/usr/lib/dotnet"

  install -dm 755 "${pkgdir}"/usr/{bin,lib,share/licenses/dotnet-core}
  install -dm 755 "${root}" "${root}/shared" "${root}/packs"
  cp -dr --no-preserve='ownership' dotnet host dnx "${root}/"
  cp -dr --no-preserve='ownership' LICENSE.txt ThirdPartyNotices.txt "${pkgdir}"/usr/share/licenses/dotnet-core
  ln -s dotnet-core "${pkgdir}"/usr/share/licenses/dotnet-host
  ln -sf /usr/lib/dotnet/dotnet "${pkgdir}"/usr/bin/dotnet
  ln -sf /usr/lib/dotnet/dnx "${pkgdir}"/usr/bin/dnx
  ln -sf /usr/lib/dotnet/host/fxr/"${_runtimever}"/libhostfxr.so "${pkgdir}"/usr/lib/libhostfxr.so
  install -Dm 644 "${srcdir}"/dotnet.sh -t "${pkgdir}"/etc/profile.d/

  cp -dr --no-preserve='ownership' shared/Microsoft.NETCore.App "${root}/shared/"
  ln -s dotnet-core "${pkgdir}"/usr/share/licenses/dotnet-runtime

  cp -dr --no-preserve='ownership' shared/Microsoft.AspNetCore.App "${root}/shared/"
  ln -s dotnet-core "${pkgdir}"/usr/share/licenses/aspnet-runtime

  cp -dr --no-preserve='ownership' sdk sdk-manifests templates "${root}/"
  ln -s dotnet-core "${pkgdir}"/usr/share/licenses/dotnet-sdk

  cp -dr --no-preserve='ownership' packs/Microsoft.NETCore.App.{Host.linux-${msarch},Ref} "${root}/packs/"
  ln -s dotnet-core "${pkgdir}"/usr/share/licenses/dotnet-targeting-pack

  cp -dr --no-preserve='ownership' packs/Microsoft.AspNetCore.App.Ref "${root}/packs/"
  ln -s dotnet-core "${pkgdir}"/usr/share/licenses/aspnet-targeting-pack
}
